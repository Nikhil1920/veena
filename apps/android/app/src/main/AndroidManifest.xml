<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".VeenaApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:theme="@style/Theme.Veena"
        android:enableOnBackInvokedCallback="true">
        <!-- Android 16 (API 36) adaptive layout: orientation/resizability restrictions are
             ignored on large screens (sw >= 600dp). Keep portrait until the UI is made
             adaptive; this temporary opt-out preserves the previous behaviour and must be
             removed before targeting API 37. See
             https://developer.android.com/about/versions/16/behavior-changes-16#adaptive-layouts -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Veena">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>

{
	"name": "veena-marketing-website",
	"type": "module",
	"version": "0.0.1",
	"license": "MIT",
	"scripts": {
		"dev": "node scripts/prepare-runtime.mjs && astro dev",
		"build": "node scripts/prepare-runtime.mjs && astro build && node scripts/finish-build.mjs",
		"preview": "node scripts/preview-transcription.mjs",
		"preview:transcription": "node scripts/preview-transcription.mjs",
		"test:transcription": "node --experimental-strip-types --test tests/transcription.test.mjs",
		"test:browser": "playwright test",
		"astro": "astro",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"type-check": "astro check",
		"check": "npm run type-check && npm run lint && npm run format:check"
	},
	"dependencies": {
		"@astrojs/mdx": "^7.0.5",
		"@astrojs/react": "^6.0.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "3.7.3",
		"@iconify-json/tabler": "^1.2.26",
		"@noble/hashes": "2.0.1",
		"@tailwindcss/vite": "^4.1.18",
		"astro": "^7.2.0",
		"astro-icon": "^1.1.5",
		"fft.js": "4.0.4",
		"framer-motion": "^12.34.0",
		"onnxruntime-web": "1.29.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"sass": "^1.97.3",
		"tailwindcss": "^4.1.18"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.58.0",
		"@tailwindcss/typography": "^0.5.19",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@typescript-eslint/eslint-plugin": "^8.55.0",
		"@typescript-eslint/parser": "^8.55.0",
		"eslint": "^9.39.5",
		"eslint-plugin-astro": "^1.5.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"prettier": "^3.8.1",
		"prettier-plugin-astro": "^0.14.1",
		"terser": "^5.46.0",
		"typescript": "^5.9.3"
	}
}

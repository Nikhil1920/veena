---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";
import { SITE, DOWNLOADS } from "../config/site.mjs";

const title =
	"Speech to Text App for Android — 22 Indian Languages, Offline | Veena";
const description =
	"Veena is a free Android speech to text app for Telugu, Hindi, Tamil, Bengali and 18 more Indian languages. Hold to dictate or import an audio file, all offline on your phone.";

const canonical = `${SITE.url}/android/`;

const appJsonLd = {
	"@context": "https://schema.org",
	"@type": "MobileApplication",
	name: "Veena",
	applicationCategory: "ProductivityApplication",
	operatingSystem: "Android 8.0+",
	description: description,
	url: canonical,
	inLanguage: "en",
	author: { "@type": "Person", name: SITE.author },
	offers: { "@type": "Offer", price: "0", priceCurrency: "INR" },
	installUrl: DOWNLOADS.playStore,
};
---

<Layout
	title={title}
	description={description}
	canonicalURL={canonical}
	jsonLd={appJsonLd}
>
	<Header />
	<main id="main-content" role="main">
		<section class="max-w-4xl mx-auto px-4 py-16 md:py-20">
			<p class="text-sm font-medium text-gray-500 uppercase tracking-wide mb-3">
				Veena for Android
			</p>
			<h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
				Speech to text on Android, in your language
			</h1>
			<p class="text-xl text-gray-600 mb-8 max-w-3xl">
				Most Android keyboards and dictation tools send your voice to a server
				before text comes back. Veena runs the whole recognition engine on your
				phone: pick one of the 22 scheduled languages of India, hold the
				microphone button, and watch the transcript appear. No connection
				needed, no audio uploaded, no account.
			</p>
			<div class="mb-14">
				<a class="button-primary" href={DOWNLOADS.playStore}
					>Get Veena on Google Play</a
				>
				<p class="mt-3 text-sm text-gray-500">
					{DOWNLOADS.android.requirement} · free
				</p>
			</div>

			<section aria-labelledby="android-how" class="mb-14">
				<h2 id="android-how" class="text-2xl font-bold text-gray-900 mb-6">
					How dictation works on Android
				</h2>
				<div class="space-y-6 max-w-3xl">
					<div>
						<h3 class="text-lg font-semibold text-gray-900 mb-1">
							Hold to record, or tap for long dictation
						</h3>
						<p class="text-gray-600">
							Hold the mic button for a quick sentence, or switch to tap mode
							for paragraphs at a time. Either way the recording is transcribed
							on the phone the moment you stop.
						</p>
					</div>
					<div>
						<h3 class="text-lg font-semibold text-gray-900 mb-1">
							Import recordings you already have
						</h3>
						<p class="text-gray-600">
							Pick an audio file instead of speaking live, and Veena transcribes
							it on the device. Useful for voice memos you recorded elsewhere.
						</p>
					</div>
					<div>
						<h3 class="text-lg font-semibold text-gray-900 mb-1">
							Your history lives on the phone
						</h3>
						<p class="text-gray-600">
							Every transcript is saved with its recording so you can replay it,
							edit the text, copy it again, or delete it. The history is stored
							locally and never synced anywhere.
						</p>
					</div>
					<div>
						<h3 class="text-lg font-semibold text-gray-900 mb-1">
							Copy or share into any app
						</h3>
						<p class="text-gray-600">
							One tap sends the transcript to WhatsApp, Gmail, Keep, your notes
							app, or the clipboard.
						</p>
					</div>
				</div>
			</section>

			<section aria-labelledby="android-offline" class="mb-14">
				<h2 id="android-offline" class="text-2xl font-bold text-gray-900 mb-4">
					Built for patchy networks
				</h2>
				<p class="text-gray-700 mb-4 max-w-3xl">
					The first launch downloads a speech model to your phone, about 125 MB
					if you dictate in Telugu (it has a dedicated model) or about 480 MB
					for the multilingual model that covers all 22 languages. After that
					one-time download, dictation needs zero connectivity. In a moving
					train, in a village with one bar of signal, on a flight, Veena
					transcribes exactly as fast as it does on wifi.
				</p>
			</section>

			<section
				class="bg-gray-50 border border-gray-200 rounded-2xl p-8"
				aria-label="Related pages"
			>
				<h2 class="text-xl font-bold text-gray-900 mb-3">
					Not sure about your language?
				</h2>
				<p class="text-gray-600 mb-4">
					Browse what Veena can do in it, then install the app:
				</p>
				<a
					href="/speech-to-text"
					class="inline-flex items-center gap-2 px-5 py-3 bg-gray-900 text-white rounded-lg font-medium hover:bg-gray-700 transition-colors"
				>
					<Icon name="tabler:language" class="w-5 h-5" aria-hidden="true" />
					All 22 supported languages
				</a>
			</section>
		</section>
	</main>
	<Footer />
</Layout>

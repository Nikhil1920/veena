---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";
import { SITE, DOWNLOADS } from "../config/site.mjs";

const title =
	"Speech to Text App for iPhone — Indian Languages, On-Device | Veena";
const description =
	"Veena brings offline speech to text to the iPhone in Telugu, Hindi, Tamil and 19 more Indian languages. Free on the App Store, no account, no cloud, your audio never leaves the phone.";

const canonical = `${SITE.url}/ios/`;

const appJsonLd = {
	"@context": "https://schema.org",
	"@type": "MobileApplication",
	name: "Veena",
	applicationCategory: "ProductivityApplication",
	operatingSystem: "iOS",
	description: description,
	url: canonical,
	inLanguage: "en",
	author: { "@type": "Person", name: SITE.author },
	offers: { "@type": "Offer", price: "0", priceCurrency: "INR" },
	installUrl: DOWNLOADS.appStore,
};
---

<Layout
	title={title}
	description={description}
	canonicalURL={canonical}
	jsonLd={appJsonLd}
>
	<Header />
	<main id="main-content" role="main">
		<section class="max-w-4xl mx-auto px-4 py-16 md:py-20">
			<p class="text-sm font-medium text-gray-500 uppercase tracking-wide mb-3">
				Veena for iPhone
			</p>
			<h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
				Speech to text on iPhone that never phones home
			</h1>
			<p class="text-xl text-gray-600 mb-8 max-w-3xl">
				Veena turns speech in all 22 scheduled languages of India into text,
				directly on your iPhone. Download its model once, then dictate in
				Telugu, Tamil, or your own language with airplane mode on. Free, with no
				account needed.
			</p>
			<div class="mb-14">
				<a class="button-primary" href={DOWNLOADS.appStore}
					>Download Veena on the App Store</a
				>
				<p class="mt-3 text-sm text-gray-500">
					{DOWNLOADS.ios.requirement} · free
				</p>
			</div>

			<section aria-labelledby="ios-how" class="mb-14">
				<h2 id="ios-how" class="text-2xl font-bold text-gray-900 mb-6">
					What you get on iOS
				</h2>
				<div class="space-y-6 max-w-3xl">
					<div>
						<h3 class="text-lg font-semibold text-gray-900 mb-1">
							A native SwiftUI app
						</h3>
						<p class="text-gray-600">
							Veena is built for the iPhone, not ported through a wrapper. Hold
							the mic button for quick notes or tap once for long dictation;
							either way recognition runs locally.
						</p>
					</div>
					<div>
						<h3 class="text-lg font-semibold text-gray-900 mb-1">
							Dictate in 22 languages
						</h3>
						<p class="text-gray-600">
							Pick your language during setup. Telugu uses a dedicated model;
							the other 21 scheduled languages share one multilingual model
							trained on all of them, each decoding through its own vocabulary.
						</p>
					</div>
					<div>
						<h3 class="text-lg font-semibold text-gray-900 mb-1">
							A voice keyboard for every app
						</h3>
						<p class="text-gray-600">
							Add the Veena keyboard in Settings and dictate in Messages,
							WhatsApp, Notes, or anywhere you type. iOS doesn't let keyboards
							use the microphone, so the keyboard's mic hands your voice to the
							Veena app, which transcribes it on your iPhone and sends the text
							back. It needs Full Access only so the keyboard and the app can
							talk to each other; nothing leaves your phone.
						</p>
					</div>
					<div>
						<h3 class="text-lg font-semibold text-gray-900 mb-1">
							Transcribe recordings, not just live speech
						</h3>
						<p class="text-gray-600">
							Import a voice memo or any audio file from Files, and Veena
							transcribes it on the phone.
						</p>
					</div>
					<div>
						<h3 class="text-lg font-semibold text-gray-900 mb-1">
							History you control
						</h3>
						<p class="text-gray-600">
							Transcripts are saved on the device with their audio so you can
							replay, edit, copy, or delete them. Nothing syncs, nothing leaves.
						</p>
					</div>
				</div>
			</section>

			<section aria-labelledby="ios-setup" class="mb-14">
				<h2 id="ios-setup" class="text-2xl font-bold text-gray-900 mb-4">
					Set up once. Speak offline.
				</h2>
				<p class="text-gray-700 max-w-3xl">
					Install from the App Store, allow microphone access, choose your
					language, and Veena downloads its speech model over wifi (about 125 MB
					for Telugu, about 480 MB for all 22 languages). From then on the app
					works offline, with your recordings processed on your phone.
				</p>
			</section>

			<section
				class="bg-gray-50 border border-gray-200 rounded-2xl p-8"
				aria-label="Related pages"
			>
				<h2 class="text-xl font-bold text-gray-900 mb-3">
					Check your language first
				</h2>
				<p class="text-gray-600 mb-4">
					Every scheduled language of India is supported:
				</p>
				<a
					href="/speech-to-text"
					class="inline-flex items-center gap-2 px-5 py-3 bg-gray-900 text-white rounded-lg font-medium hover:bg-gray-700 transition-colors"
				>
					<Icon name="tabler:language" class="w-5 h-5" aria-hidden="true" />
					Browse the 22 supported languages
				</a>
			</section>
		</section>
	</main>
	<Footer />
</Layout>

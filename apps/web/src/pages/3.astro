---
/**
 * Iteration 3 — "Register".
 * A government census register / case file: the Eighth Schedule of the
 * Constitution entered row by row, vermillion stamps, handwritten margin
 * notes. Spectral for the record, Caveat for the clerk's pencil.
 */
import Switcher from "../components/iterations/Switcher.astro";

const ROWS: Array<{
	no: number; en: string; native: string; code: string; script: string; speakers: string; note?: string;
}> = [
	{ no: 1, en: "Assamese", native: "অসমীয়া", code: "as", script: "Assamese (Eastern Nagari)", speakers: "about 25 million" },
	{ no: 2, en: "Bengali", native: "বাংলা", code: "bn", script: "Bengali", speakers: "about 100 million" },
	{ no: 3, en: "Bodo", native: "बड़ो", code: "brx", script: "Devanagari", speakers: "about 1.5 million" },
	{ no: 4, en: "Dogri", native: "डोगरी", code: "doi", script: "Devanagari", speakers: "about 2.5 million" },
	{ no: 5, en: "Gujarati", native: "ગુજરાતી", code: "gu", script: "Gujarati", speakers: "about 60 million" },
	{ no: 6, en: "Hindi", native: "हिन्दी", code: "hi", script: "Devanagari", speakers: "more than 500 million", note: "the biggest ledger line" },
	{ no: 7, en: "Kannada", native: "ಕನ್ನಡ", code: "kn", script: "Kannada", speakers: "about 45 million" },
	{ no: 8, en: "Kashmiri", native: "کٲشُر", code: "ks", script: "Perso-Arabic, also Devanagari", speakers: "about 7 million" },
	{ no: 9, en: "Konkani", native: "कोंकणी", code: "gom", script: "Devanagari", speakers: "about 2.5 million" },
	{ no: 10, en: "Maithili", native: "मैथिली", code: "mai", script: "Devanagari, also Tirhuta", speakers: "about 35 million" },
	{ no: 11, en: "Malayalam", native: "മലയാളം", code: "ml", script: "Malayalam", speakers: "about 38 million" },
	{ no: 12, en: "Manipuri", native: "ꯃꯤꯇꯩꯂꯣꯟ", code: "mni", script: "Meitei Mayek", speakers: "about 2 million" },
	{ no: 13, en: "Marathi", native: "मराठी", code: "mr", script: "Devanagari", speakers: "about 85 million" },
	{ no: 14, en: "Nepali", native: "नेपाली", code: "ne", script: "Devanagari", speakers: "about 16 million in India" },
	{ no: 15, en: "Odia", native: "ଓଡ଼ିଆ", code: "or", script: "Odia", speakers: "about 40 million" },
	{ no: 16, en: "Punjabi", native: "ਪੰਜਾਬੀ", code: "pa", script: "Gurmukhi", speakers: "about 35 million in India" },
	{ no: 17, en: "Sanskrit", native: "संस्कृतम्", code: "sa", script: "Devanagari", speakers: "about 25,000, revival ongoing" },
	{ no: 18, en: "Santali", native: "ᱥᱟᱱᱛᱟᱲᱤ", code: "sat", script: "Ol Chiki", speakers: "about 8 million" },
	{ no: 19, en: "Sindhi", native: "سنڌي", code: "sd", script: "Perso-Arabic, also Devanagari", speakers: "about 3 million in India" },
	{ no: 20, en: "Tamil", native: "தமிழ்", code: "ta", script: "Tamil", speakers: "about 75 million" },
	{ no: 21, en: "Telugu", native: "తెలుగు", code: "te", script: "Telugu", speakers: "about 90 million", note: "carries its own model" },
	{ no: 22, en: "Urdu", native: "اردو", code: "ur", script: "Perso-Arabic (Nastaliq)", speakers: "about 50 million in India" },
];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Veena — the register · iteration 3</title>
		<meta name="description" content="Veena turns speech into text in all 22 scheduled languages of India, entirely on your device. Free, offline, open source." />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Caveat:wght@600&display=swap" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@500&family=Noto+Sans+Devanagari:wght@500&family=Noto+Sans+Tamil:wght@500&family=Noto+Sans+Telugu:wght@500&family=Noto+Sans+Kannada:wght@500&family=Noto+Sans+Malayalam:wght@500&family=Noto+Sans+Gurmukhi:wght@500&family=Noto+Sans+Gujarati:wght@500&family=Noto+Sans+Oriya:wght@500&family=Noto+Sans+Arabic:wght@500&family=Noto+Sans+Meetei+Mayek:wght@500&family=Noto+Sans+Ol+Chiki:wght@500&display=swap" />
	</head>
	<body data-iteration="3">
		<div class="desk">
			<article class="file">
				<div class="tab" aria-hidden="true">Veena · speech / text</div>

				<header class="cover">
					<p class="matter">In the matter of: your voice, recorded nowhere</p>
					<h1>Twenty&#8209;two languages, entered into the&nbsp;record.</h1>
					<p class="cover-body">
						Veena is speech to text for every scheduled language of India.
						Speak; the words are written down on your device and stay there.
						No account, no fee, no network consulted.
					</p>
					<div class="stamp" aria-label="Runs entirely on device, no cloud">On device<span class="stamp-sub">no cloud</span></div>
					<p class="margin-note" aria-hidden="true">even in flight mode</p>
				</header>

				<section class="register" aria-label="The 22 scheduled languages Veena supports">
					<div class="reg-head">
						<h2>The Eighth Schedule, as supported by Veena</h2>
						<p class="reg-sub">Speaker figures are census estimates, kept soft on purpose.</p>
					</div>
					<table>
						<thead>
							<tr>
								<th scope="col" class="c-no">No.</th>
								<th scope="col" class="c-lang">Language</th>
								<th scope="col" class="c-script">Script</th>
								<th scope="col" class="c-speak">Speakers</th>
								<th scope="col" class="c-entry">Entry</th>
							</tr>
						</thead>
						<tbody>
							{ROWS.map((r) => (
								<tr>
									<td class="c-no">{r.no}</td>
									<td class="c-lang">
										<span class="native" dir={r.code === "ks" || r.code === "sd" || r.code === "ur" ? "rtl" : "ltr"} lang={r.code}>{r.native}</span>
										<span class="en">{r.en}</span>
										{r.note && <span class="pencil">{r.note}</span>}
									</td>
									<td class="c-script">{r.script}</td>
									<td class="c-speak">{r.speakers}</td>
									<td class="c-entry">supported</td>
								</tr>
							))}
						</tbody>
					</table>
				</section>

				<section class="procedure" aria-label="How an entry is made">
					<h2>How an entry is made</h2>
					<ol class="steps">
						<li>
							<h3>Recorded</h3>
							<p>Hold the mic and talk. The recording exists on your device and only there.</p>
						</li>
						<li>
							<h3>Entered</h3>
							<p>The model on your phone turns the speech into text. The network is never dialed — the model was downloaded once, and after that the app owes nothing to anyone.</p>
						</li>
						<li>
							<h3>Filed</h3>
							<p>Copy, share, or edit the transcript. On Windows it pastes straight into whatever you were already writing in.</p>
						</li>
					</ol>
				</section>

				<section class="annexures" aria-label="Downloads">
					<h2>Annexures</h2>
					<ul class="annex-list">
						<li>
							<span class="annex-label">Annexure A</span>
							<a href="https://play.google.com/store/apps/details?id=com.byanr.veena">Android, from the Play Store</a>
							<span class="annex-note">Android 8.0 or later</span>
						</li>
						<li>
							<span class="annex-label">Annexure B</span>
							<a href="https://apps.apple.com/us/app/id6769981675">iPhone, from the App Store</a>
						</li>
						<li>
							<span class="annex-label">Annexure C</span>
							<a href="https://dl.byanr.com/veena-byanr/desktop/Veena_0.0.2_x64-setup.exe">Windows installer, version 0.0.2</a>
							<span class="annex-note">about 18 MB · Windows 10 or 11, 64-bit</span>
						</li>
					</ul>
					<p class="annex-tail">
						The whole file is public. Veena is open source under the MIT licence —
						<a href="https://github.com/Nikhil1920/veena">read every page on GitHub</a>.
					</p>
				</section>

				<footer class="seal-row">
					<span class="seal" aria-hidden="true">MIT</span>
					<p>Veena, by Nikhil Reddy Avuthu — free, offline, open source.</p>
				</footer>
			</article>
		</div>

		<Switcher index={3} surface="light" accent="#A93B22" />
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		background: #191510;
		font-family: "Spectral", Georgia, serif;
		color: #221f16;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}
	.native {
		font-family: "Noto Sans Bengali", "Noto Sans Devanagari", "Noto Sans Tamil",
			"Noto Sans Telugu", "Noto Sans Kannada", "Noto Sans Malayalam",
			"Noto Sans Gurmukhi", "Noto Sans Gujarati", "Noto Sans Oriya",
			"Noto Sans Arabic", "Noto Sans Meetei Mayek", "Noto Sans Ol Chiki", sans-serif;
	}
	a:focus-visible { outline: 2px solid #a93b22; outline-offset: 3px; border-radius: 2px; }

	.desk {
		padding: clamp(18px, 4vw, 56px) clamp(10px, 3vw, 40px) clamp(80px, 10vw, 140px);
	}
	.file {
		position: relative;
		max-width: 880px;
		margin: 0 auto;
		background: #f2ebd8;
		padding: clamp(28px, 5vw, 64px) clamp(22px, 6vw, 72px) clamp(28px, 4vw, 48px);
		box-shadow:
			inset 0 0 90px rgba(120, 96, 48, 0.14),
			0 1px 0 #c9bd9c,
			0 14px 40px rgba(0, 0, 0, 0.5);
	}
	/* two older sheets peeking from behind */
	.file::before,
	.file::after {
		content: "";
		position: absolute;
		inset: 0;
		background: #e4d9ba;
		z-index: -1;
	}
	.file::before { transform: rotate(0.7deg) translate(5px, 6px); }
	.file::after { transform: rotate(-0.5deg) translate(-6px, 4px); background: #ddd0ac; }

	.tab {
		position: absolute;
		top: -30px;
		left: clamp(18px, 5vw, 56px);
		background: #d9cbA4;
		color: #221f16;
		font-size: 13.5px;
		font-weight: 600;
		letter-spacing: 0.04em;
		padding: 7px 22px 9px;
		border-radius: 8px 8px 0 0;
		opacity: 0.92;
	}

	/* ---------- cover ---------- */
	.cover { position: relative; padding-bottom: 34px; border-bottom: 3px double #221f16; }
	.matter { font-style: italic; font-size: 16px; opacity: 0.7; margin: 0 0 18px; }
	.cover h1 {
		font-size: clamp(34px, 5.2vw, 56px);
		font-weight: 600;
		line-height: 1.08;
		letter-spacing: -0.01em;
		margin: 0 0 20px;
		max-width: 15em;
	}
	.cover-body { font-size: 17px; max-width: 36em; margin: 0; opacity: 0.88; }
	.stamp {
		position: absolute;
		right: clamp(0px, 3vw, 20px);
		bottom: 26px;
		display: grid;
		justify-items: center;
		gap: 2px;
		transform: rotate(-8deg);
		border: 3px double #a93b22;
		border-radius: 6px;
		color: #a93b22;
		padding: 12px 22px;
		font-weight: 700;
		font-size: 21px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		mix-blend-mode: multiply;
		opacity: 0.85;
	}
	.stamp-sub { font-size: 11px; letter-spacing: 0.3em; font-weight: 600; }
	.margin-note {
		font-family: "Caveat", cursive;
		font-size: 22px;
		color: #35507c;
		transform: rotate(-2.5deg);
		margin: 14px 0 0;
		text-decoration: underline;
		text-decoration-style: wavy;
		text-decoration-color: rgba(53, 80, 124, 0.5);
		text-underline-offset: 5px;
		width: fit-content;
	}

	/* ---------- register ---------- */
	.register { padding: 40px 0 8px; }
	.reg-head h2 { font-size: 24px; font-weight: 700; margin: 0 0 4px; }
	.reg-sub { font-style: italic; font-size: 14.5px; opacity: 0.62; margin: 0 0 22px; }
	table {
		width: 100%;
		border-collapse: collapse;
		border-top: 3px double #221f16;
		border-bottom: 3px double #221f16;
		font-size: 15px;
	}
	th {
		font-style: italic;
		font-weight: 500;
		font-size: 14px;
		opacity: 0.66;
		text-align: left;
		padding: 10px 10px 8px 2px;
		border-bottom: 1px solid #221f16;
	}
	td {
		padding: 9px 10px 9px 2px;
		border-bottom: 1px solid rgba(34, 31, 22, 0.28);
		vertical-align: baseline;
	}
	tbody tr:last-child td { border-bottom: none; }
	tbody tr:hover td { background: rgba(169, 59, 34, 0.05); }
	.c-no { width: 34px; font-variant-numeric: tabular-nums; opacity: 0.6; }
	.c-script { width: 24%; font-size: 13.5px; opacity: 0.8; }
	.c-speak { width: 22%; font-size: 13.5px; opacity: 0.8; }
	.c-entry { width: 15%; color: #a93b22; font-weight: 600; font-size: 13.5px; }
	.c-lang .native {
		display: inline-block;
		font-size: 19px;
		font-weight: 500;
		margin-right: 10px;
		line-height: 1.6;
	}
	.c-lang .en { font-weight: 600; }
	.pencil {
		display: block;
		font-family: "Caveat", cursive;
		font-size: 18px;
		line-height: 1.1;
		color: #35507c;
		transform: rotate(-1.2deg);
	}

	/* ---------- procedure ---------- */
	.procedure { padding: 40px 0 44px; border-top: 1px solid rgba(34, 31, 22, 0.35); }
	.procedure h2 { font-size: 24px; font-weight: 700; margin: 0 0 20px; }
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
		counter-reset: step;
	}
	.steps li { border-left: 1px solid rgba(34, 31, 22, 0.35); padding-left: 16px; }
	.steps h3 {
		font-size: 18px;
		font-weight: 700;
		margin: 0 0 8px;
	}
	.steps h3::before {
		counter-increment: step;
		content: counter(step, lower-roman) ". ";
		font-style: italic;
		font-weight: 500;
		color: #a93b22;
	}
	.steps p { font-size: 14.5px; margin: 0; opacity: 0.85; }

	/* ---------- annexures ---------- */
	.annexures { border-top: 3px double #221f16; padding: 36px 0 8px; }
	.annexures h2 { font-size: 24px; font-weight: 700; margin: 0 0 18px; }
	.annex-list { list-style: none; margin: 0; padding: 0; }
	.annex-list li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 6px 14px;
		padding: 12px 2px;
		border-bottom: 1px solid rgba(34, 31, 22, 0.28);
	}
	.annex-label { font-style: italic; font-size: 14px; opacity: 0.6; min-width: 96px; }
	.annex-list a {
		color: #a93b22;
		font-weight: 600;
		font-size: 16.5px;
		text-decoration: underline;
		text-decoration-thickness: 1.5px;
		text-underline-offset: 4px;
	}
	.annex-list a:hover { color: #7c2a15; }
	.annex-note { font-size: 13.5px; opacity: 0.65; }
	.annex-tail { margin: 20px 0 0; font-size: 15.5px; }
	.annex-tail a { color: #a93b22; font-weight: 600; }

	/* ---------- seal ---------- */
	.seal-row {
		margin-top: 40px;
		padding-top: 22px;
		border-top: 1px solid rgba(34, 31, 22, 0.35);
		display: flex;
		align-items: center;
		gap: 18px;
	}
	.seal {
		display: grid;
		place-items: center;
		width: 54px;
		height: 54px;
		flex: none;
		border: 2px solid #a93b22;
		border-radius: 50%;
		box-shadow: inset 0 0 0 3px #f2ebd8, inset 0 0 0 4.5px #a93b22;
		color: #a93b22;
		font-weight: 700;
		font-size: 14px;
		letter-spacing: 0.08em;
		transform: rotate(6deg);
		mix-blend-mode: multiply;
	}
	.seal-row p { margin: 0; font-size: 14.5px; opacity: 0.75; }

	@media (max-width: 720px) {
		.stamp { position: static; margin-top: 22px; width: fit-content; }
		.steps { grid-template-columns: 1fr; gap: 18px; }
		.c-speak, th.c-speak { display: none; }
		td.c-script { font-size: 12.5px; }
		.tab { top: -26px; font-size: 12px; }
	}
	@media (prefers-reduced-motion: reduce) {
		* { transition: none !important; }
	}
</style>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
	title="Page not found | Veena"
	description="That page does not exist. Browse Veena's supported languages, features, or download the app."
	noindex={true}
>
	<Header />
	<main id="main-content" role="main">
		<section class="max-w-3xl mx-auto px-4 py-24 text-center">
			<h1 class="text-4xl font-bold text-gray-900 mb-4">
				That page does not exist
			</h1>
			<p class="text-xl text-gray-600 mb-10">
				The link is broken or the page moved. Here is where you probably meant
				to go:
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a
					href="/download"
					class="px-6 py-3 bg-gray-900 text-white rounded-lg font-medium hover:bg-gray-700 transition-colors"
					>Download Veena</a
				>
				<a
					href="/speech-to-text"
					class="px-6 py-3 border border-gray-300 text-gray-900 rounded-lg font-medium hover:bg-gray-50 transition-colors"
					>Supported languages</a
				>
				<a
					href="/"
					class="px-6 py-3 text-gray-700 rounded-lg font-medium hover:bg-gray-50 transition-colors"
					>Home</a
				>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
